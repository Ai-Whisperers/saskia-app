# Tier 8 — Observability env vars (2026-10-01).
# Copy to .env / docker-compose and fill in the values. Anything
# left blank is treated as "feature off" (no Sentry init, no email
# sent, no alert fired).

# Sentry error tracking (free tier 5K events/mo).
# Sign up at https://sentry.io, create a FastAPI project, copy the
# DSN from Project Settings → Client Keys (DSN).
# SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ENVIRONMENT=production

# Transactional email via Resend (free tier 100/day, 3K/month).
# Sign up at https://resend.com, add an API key, verify a sending
# domain (aiwhisperers.dev is already verified).
# RESEND_API_KEY=re_...

# Where alerts get delivered. Default is ivan@aiwhisperers.dev.
ALERT_EMAIL_TO=ivan@aiwhisperers.dev

# Sender. The domain MUST be verified on Resend's side. Default
# uses aiwhisperers.dev.
ALERT_EMAIL_FROM="Saskia RMS <noreply@aiwhisperers.dev>"

# Set to 1 in dev/test to log alert payloads without sending.
# DO NOT enable in production — the operator won't get paged.
ALERT_EMAIL_DRY_RUN=0
